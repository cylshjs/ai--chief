# 复制成 .env 再填上自己的值：cp .env.example .env


# 模型：qwen 多模态，走 DashScope 的 OpenAI 兼容接口
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜菜谱
TAVILY_API_KEY=

# 阿里云 OSS：前端取签名后图片直传，不经过后端
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 可选，不填就是下面这个默认值
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# 可选：依赖里带了 DeepSeek，代码目前没用到
DEEPSEEK_API_KEY=

# 可选：LangSmith 追踪，不要就删掉这三行
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-chief
